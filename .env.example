# Local. Copia este archivo a .env y completa los valores.
DATABASE_URL=postgresql://reviewcanvas:change_this_password@127.0.0.1:5432/reviewcanvas
# Neon. Usa el URL directo con TLS para migrar y el URL pooled con TLS para la API.
DATABASE_URL_DIRECT=
DATABASE_POOL_MAX=3
APP_ORIGIN=http://127.0.0.1:5173
PORT=4174
HOST=127.0.0.1
COOKIE_SECURE=false
SERVE_FRONTEND=false

# Solo servidor. En producción, usa el mismo secreto en Render y Pages Functions.
API_PROXY_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=reviewcanvas-private

# Opcional y vacío durante el lanzamiento gratuito.
GOOGLE_PLACES_API_KEY=
VITE_ENABLE_PLACES_SEARCH=false

# Opcional. Habilita cuentas, sincronización y QR dinámicos en una instalación con API.
VITE_ENABLE_CLOUD_ACCOUNTS=false

# Variables del runtime de Cloudflare Pages Functions. Configúralas en su panel.
# API_ORIGIN=https://reviewcanvas-api.onrender.com
# API_PROXY_SECRET=<mismo valor que Render>

# Docker Compose local. Usa caracteres seguros para una URL.
POSTGRES_PASSWORD=
DOCKER_APP_ORIGIN=http://127.0.0.1:5173
