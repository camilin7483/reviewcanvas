{
  "name": "reviewcanvas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "build:frontend": "vite build"
  },
  "dependencies": {
    "@fastify/cookie": "^11",
    "@fastify/helmet": "^13",
    "@fastify/rate-limit": "^10",
    "@fastify/static": "^10.1.12",
    "@fontsource-variable/dm-sans": "^5",
    "@fontsource-variable/lora": "^5",
    "@fontsource/barlow-condensed": "^5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "dompurify": "^3.4.11",
    "fabric": "^7",
    "fastify": "^5",
    "fflate": "^0.8.3",
    "idb": "^8",
    "jspdf": "^4",
    "lucide-react": "^0.577.0",
    "qr-code-styling": "^1.9.2",
    "react": "^19",
    "react-dom": "^19",
    "saxes": "^6.0.0",
    "tsx": "^4",
    "zod": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "~5.9.3",
    "vite": "^8",
    "vitest": "^4"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
